# Скопируй в .env.local и поменяй при необходимости.

# Моки API в браузере (MSW): true — работаем без бэка.
VITE_API_MOCK=true

# Куда dev-сервер проксирует /api, когда моки выключены.
API_PROXY_TARGET=http://localhost:8080

# Ключ 2ГИС для карты и поиска точки по адресу (публичный, ограничьте по домену в кабинете 2ГИС).
# В кабинете у ключа должны быть включены MapGL JS API, Map Tiles API и Geocoder API. Пусто — карта не показывается.
VITE_2GIS_KEY=
