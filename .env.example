# Скопируйте в .env и заполните. .env не коммитится.
# Приложение читает .env из текущего каталога (spring.config.import=optional:file:.env).
# Переменные окружения процесса имеют приоритет над значениями из .env.
DB_URL=jdbc:postgresql://localhost:5432/Stoloto
DB_USER=admin
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Base64, не меньше 32 байт после декодирования: openssl rand -base64 48
# Если не задать, используется публичный dev-ключ из application.properties.
JWT_SECRET=

# Необязательные (значения по умолчанию указаны в application.properties)
# JWT_TTL=24h
# AVATARS_DIR=data/avatars
# AVATARS_PUBLIC_URL=
# APP_ZONE=Asia/Krasnoyarsk
# SERVER_PORT=8080
